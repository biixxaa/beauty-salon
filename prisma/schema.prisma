// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  SALON_OWNER
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum SalonCategory {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum ServiceCategory {
  HAIRCUT
  SHAVE
  BEARD_TRIM
  NAILS
  SPA
  MASSAGE
  HAIR_TREATMENT
  MAKEUP
  FACIAL
  COLORING
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  TELEBIRR
  CBE_BIRR
}

enum TransactionType {
  REFERRAL_BONUS
  BOOKING_SPEND
  BOOKING_EARN
  TOP_UP
  CASHBACK
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?       @unique
  role         Role          @default(CUSTOMER)
  avatarUrl    String?
  googleId     String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  // Relations
  profile      Profile?
  salons       Salon[]       @relation("SalonOwner")
  employee     Employee?
  bookings     Booking[]     @relation("CustomerBookings")
  reviews      Review[]      @relation("CustomerReviews")
  invitationsCreated Invitation[] @relation("InvitationCreator")
  invitationsUsed Invitation[] @relation("InvitationUser")
  auditLogs    AuditLog[]
  notifications Notification[]

  @@index([email])
  @@index([role])
}

model Invitation {
  id          String   @id @default(uuid())
  code        String   @unique
  targetEmail String?
  role        Role     @default(SALON_OWNER)
  isUsed      Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedById    String?
  usedBy      User?    @relation("InvitationUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([code])
}

model Profile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  hairType       String?   // straight, wavy, curly, coily, kinky
  faceShape      String?   // oval, round, square, heart, diamond
  stylePreference String?  // AI recommended styles or notes
  referralCode   String    @unique
  referredById   String?
  points         Int       @default(0)
  walletBalance  Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  transactions   WalletTransaction[]

  @@index([referralCode])
}

model Salon {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  slug           String          @unique
  description    String?
  category       SalonCategory   @default(UNISEX)
  address        String
  latitude       Float
  longitude      Float
  phone          String
  email          String
  bannerUrl      String?
  rating         Float           @default(0.0)
  reviewCount    Int             @default(0)
  isVerified     Boolean         @default(false)
  featured       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  portfolio      SalonPortfolio[]
  workingHours   WorkingHours[]
  services       Service[]
  employees      Employee[]
  bookings       Booking[]
  reviews        Review[]
  coupons        Coupon[]

  @@index([latitude, longitude])
  @@index([slug])
  @@index([category])
  @@index([isVerified, featured])
}

model SalonPortfolio {
  id          String   @id @default(uuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())
}

model WorkingHours {
  id         String   @id @default(uuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 (Sunday) to 6 (Saturday)
  openTime   String   // e.g. "08:00"
  closeTime  String   // e.g. "20:00"
  isClosed   Boolean  @default(false)

  @@unique([salonId, dayOfWeek])
}

model Service {
  id          String          @id @default(uuid())
  salonId     String
  salon       Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  duration    Int             // in minutes
  bufferTime  Int             @default(0) // in minutes
  category    ServiceCategory @default(OTHER)
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  employees   EmployeeService[]
  bookings    Booking[]

  @@index([salonId])
  @@index([category])
}

model Employee {
  id          String            @id @default(uuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  salonId     String
  salon       Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name        String
  bio         String?
  resumeUrl   String?           // URL to staff member's resume/CV
  rating      Float             @default(0.0)
  reviewCount Int               @default(0)
  avatarUrl   String?
  isAvailable Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  services    EmployeeService[]
  schedule    EmployeeSchedule[]
  bookings    Booking[]

  @@index([salonId])
}

model EmployeeService {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
}

model EmployeeSchedule {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0 (Sunday) to 6 (Saturday)
  startTime  String   // e.g. "08:00"
  endTime    String   // e.g. "17:00"
  isBreak    Boolean  @default(false) // If true, represents a break block

  @@index([employeeId, dayOfWeek])
}

model Booking {
  id              String        @id @default(uuid())
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  salonId         String
  salon           Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus @default(PENDING)
  
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH)
  paymentDetails  Json?         // Stores reference keys from Telebirr, CBE Birr or Stripe
  
  totalPrice      Decimal       @db.Decimal(10, 2)
  discountApplied Decimal       @default(0.00) @db.Decimal(10, 2)
  finalPrice      Decimal       @db.Decimal(10, 2)
  couponCode      String?
  
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  review          Review?
  paymentTransaction PaymentTransaction?

  @@index([customerId])
  @@index([salonId])
  @@index([employeeId, startTime, endTime])
  @@index([status])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  rating     Int      // 1 to 5 stars
  comment    String?
  reply      String?  // Salon owner reply
  createdAt  DateTime @default(now())

  @@index([salonId])
  @@index([rating])
}

model Coupon {
  id              String    @id @default(uuid())
  salonId         String
  salon           Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  code            String    // e.g. "ETHIOBEAUTY10"
  discountPercent Int       // e.g. 10 for 10%
  maxDiscount     Decimal   @db.Decimal(10, 2)
  expiryDate      DateTime
  isActive        Boolean   @default(true)
  usageLimit      Int       @default(100)
  usageCount      Int       @default(0)
  createdAt       DateTime  @default(now())

  @@unique([salonId, code])
}

model WalletTransaction {
  id          String          @id @default(uuid())
  profileId   String
  profile     Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  description String?
  referenceId String?         // Linked booking ID or transaction reference
  createdAt   DateTime        @default(now())

  @@index([profileId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // BOOKING_REMINDER, PROMOTION, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model PaymentTransaction {
  id             String      @id @default(uuid())
  bookingId      String      @unique
  booking        Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider       String
  providerTxId   String      @unique
  status         PaymentStatus
  method         PaymentMethod
  amount         Decimal     @db.Decimal(10, 2)
  rawPayload     Json?
  receivedAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())

  @@index([bookingId])
  @@index([provider])
}
